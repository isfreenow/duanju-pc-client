{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "短剧随心看",
  "version": "0.1.6",
  "identifier": "com.administrator.hongguo-desktop-client",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "短剧随心看",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "duanju"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4RjIwQ0NBMTc3NTZCOEUKUldTT2EzVVh5Z3p5aUJSeXNwOXlscUgvY25GTjlWR1RYVDd0d2pFY1FEQXVTRTVManppNHJFaUEK",
      "endpoints": [
        "https://github.com/isfreenow/duanju-pc-client/releases/latest/download/latest.json"
      ]
    }
  }
}